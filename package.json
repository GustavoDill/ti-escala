{
  "name": "ti-escala",
  "version": "1.0.0",
  "description": "Escala de Trabalho Visualizer & Editor (Node.js + Hono + Supabase + React)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch-path=src/server src/server/index.ts\" \"vite\"",
    "dev:server": "node --watch-path=src/server src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "node --test tests/*.test.ts",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "hono": "^4.7.4",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}

